{
  "name": "blink",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "concurrently -k \"npm:dev\" \"npm:desktop:wait\"",
    "desktop:wait": "wait-on http://localhost:5173 && electron .",
    "desktop:build": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-store": "^12.0.0",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "app.blink.music",
    "productName": "Blink",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "node_modules/electron-store/**/*", "node_modules/conf/**/*", "node_modules/ajv/**/*", "node_modules/json-schema-typed/**/*"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
